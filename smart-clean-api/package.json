{
  "name": "smart-clean-api",
  "version": "1.0.0",
  "description": "Smart-Clean Fastify REST API — Backend for Customer, Rider, and Admin worlds",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:sync": "node -e \"require('fs').copyFileSync('../smart-clean/prisma/schema.prisma', 'prisma/schema.prisma'); console.log('✓ Synced schema from frontend');\" && prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
