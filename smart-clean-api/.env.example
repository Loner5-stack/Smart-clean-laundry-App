# Supabase PostgreSQL (via connection pooler — port 6543)
DATABASE_URL="postgresql://postgres.jdrbjsjelilbbsimzijy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (direct session-mode — port 5432, used for migrations)
DIRECT_URL="postgresql://postgres.jdrbjsjelilbbsimzijy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Must match the NEXTAUTH_SECRET in the Next.js frontend .env
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Shared secret between Next.js server and this Fastify API (never expose to browser)
API_SECRET="generate-a-long-random-string-here"

# Port this server listens on (Render sets PORT automatically)
PORT=3001

# Secondary passcode required for sensitive admin operations (Customers, Subscriptions, Services)
TECH_PASSKEY="your-technical-team-passcode"
